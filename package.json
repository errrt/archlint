{
  "name": "archlint-ai",
  "version": "0.1.0",
  "description": "Architecture linter for AI-generated code",
  "type": "module",
  "bin": { "archlint": "dist/index.js" },
  "files": ["dist", "templates", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "check": "npm test"
  },
  "engines": { "node": ">=18" },
  "keywords": ["architecture", "linter", "ai", "cli", "git"],
  "homepage": "https://github.com/errrt/archlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errrt/archlint.git"
  },
  "bugs": {
    "url": "https://github.com/errrt/archlint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
